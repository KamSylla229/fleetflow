# =============================================================================
# FleetFlow — variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et renseignez les valeurs. Le .env n'est JAMAIS
# versionné (voir .gitignore) : il contient des secrets.
#
#     copy .env.example .env
#
# Ce fichier d'exemple ne doit contenir aucune vraie valeur.
# =============================================================================

# --- Obligatoire -------------------------------------------------------------

# Signe les sessions et les jetons CSRF. La connaître permet de forger un
# cookie de session : elle ne doit jamais sortir de la machine.
# Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=mettez-votre-propre-cle-ici

# True en développement, False partout ailleurs. Avec False, seed_demo refuse
# de tourner (la commande est destructrice).
DEBUG=True


# --- Suivi GPS ---------------------------------------------------------------

# Minutes sans relevé au-delà desquelles un boîtier est déclaré « sans
# signal ». 30 en usage normal ; mettez 1 pour la démonstration, sinon il faut
# attendre une demi-heure devant l'écran pour voir l'alerte apparaître.
FLEETFLOW_SEUIL_SANS_SIGNAL_MIN=30

# Fond de carte de la page Carte. Laissez vide : les camions et les
# itinéraires s'affichent alors sur un aplat neutre, et l'application ne
# dépend d'aucun service extérieur.
#
# Les tuiles sont la seule chose qu'on ne peut pas servir en local (celles du
# Bénin pèsent plusieurs gigaoctets). Mais les serveurs d'OpenStreetMap sont
# tenus par des bénévoles, et leur politique d'usage interdit qu'une
# application en dépende : ils renvoient alors une image « Access blocked » à
# la place de chaque tuile. C'est arrivé en développement.
#
# Pour une démonstration ponctuelle, et en connaissance de cette politique
# (openstreetmap.org/copyright et operations.osmfoundation.org/policies/tiles) :
#   FLEETFLOW_TUILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   FLEETFLOW_TUILES_ATTRIBUTION=&copy; les contributeurs OpenStreetMap
#
# Pour un vrai déploiement : un fournisseur avec un contrat et une clé, ou vos
# propres tuiles.
FLEETFLOW_TUILES_URL=
FLEETFLOW_TUILES_ATTRIBUTION=


# --- E-mail ------------------------------------------------------------------

# Adresse qui reçoit les alertes et le rapport quotidien.
FLEETFLOW_EMAIL_GERANT=gerant@exemple.test

# Par défaut, les e-mails sont écrits dans la console et ne partent nulle
# part. Décommentez la ligne SMTP seulement quand vous voulez de vrais envois.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Expéditeur affiché dans les messages.
DEFAULT_FROM_EMAIL=FleetFlow <ne-pas-repondre@exemple.test>

# --- Option 1 : Brevo (ex-Sendinblue) ----------------------------------------
# Compte gratuit, 300 e-mails par jour, utilisable depuis le Bénin.
# La clé SMTP se crée dans « SMTP & API » puis « SMTP » : ce n'est PAS le mot
# de passe du compte Brevo.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-identifiant-smtp-brevo
# EMAIL_HOST_PASSWORD=votre-cle-smtp-brevo

# --- Option 2 : Gmail --------------------------------------------------------
# Gmail refuse le mot de passe du compte depuis 2022. Il faut un « mot de passe
# d'application » : activez la validation en deux étapes, puis
# myaccount.google.com > Sécurité > Mots de passe des applications. Google
# donne alors seize lettres à coller ci-dessous, espaces compris ou non.
# Limite indicative : 500 envois par jour.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre.adresse@gmail.com
# EMAIL_HOST_PASSWORD=les-seize-lettres-du-mot-de-passe-d-application
